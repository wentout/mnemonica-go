#!/bin/bash
# One command runs all gates (contract §4.4) in ALL THREE modules: race
# tests with 100.0% statement coverage each, vet, staticcheck, gofmt
# across the tree, and the P5 analyzer over the port's own sources.
# Exit 0 = green.
set -euo pipefail
cd "$(dirname "$0")/.."

gofmt -l . | grep -v '^$' && { echo "gofmt: unformatted files above"; exit 1; } || true

# The workspace resolves the untagged lethe module from the sibling
# checkout and pins the self-imports to the local tree. go.work is a
# local developer file (Go's own guidance: not committed) — scripts/check
# generates it if absent; .gitignore lists it.
if [ ! -f go.work ]; then
	go work init . ./tools ./otel ../lethe
fi

# Gates for one module, run in its directory; $2 is the report label. The
# runtime module is stdlib-only; tools holds the generator, the analyzer,
# and the schema validator; otel holds the OTEL link. Nothing crosses back.
check_module() {
	(
		cd "$1"
		go vet ./...
		staticcheck ./...
		go test -race -coverprofile=coverage.out ./...
		total=$(go tool cover -func=coverage.out | tail -1 | awk '{print $3}')
		echo "$2 coverage: $total"
		[ "$total" = "100.0%" ] || { echo "$2 coverage below 100.0%"; exit 1; }
	)
}

check_module . runtime
check_module tools tools
check_module otel otel

# mnemonicavet over the port's own packages: the port must be
# analyzer-clean, including its tests.
vetdir="$(mktemp -d)"
trap 'rm -rf "$vetdir"' EXIT
(
	cd tools
	go build -o "$vetdir/mnemonicavet" ./analysis/mnemonicavet
)
go vet -vettool="$vetdir/mnemonicavet" ./mnemonica/... ./mnemonicatest/...
echo "mnemonicavet over the port: clean"
